<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>ScanEzi</RootNamespace>
    <ApplicationIcon>Assets\ScanEzi.ico</ApplicationIcon>
    <AssemblyTitle>ScanEzi</AssemblyTitle>
    <Product>ScanEzi</Product>
    <Description>A small, fast Windows scanner app for flatbed and document feeder scanners.</Description>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <Authors>ScanEzi contributors</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ScanEzi.ico" />
    <Resource Include="Assets\ScanEzi-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
</Project>