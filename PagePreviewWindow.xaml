<ui:FluentWindow x:Class="ScanEzi.PagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Preview"
        Width="1040" Height="780"
        MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Icon="pack://application:,,,/Assets/ScanEzi.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <ui:FluentWindow.Resources>
        <Style x:Key="StageHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B4FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="PreviewTitleBar" Title="Preview"/>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="20,2,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button x:Name="RotateLeftButton" Appearance="Secondary" Padding="12,7" Margin="0,0,8,0"
                           Click="RotateLeftButton_Click" ToolTip="Rotate 90 degrees counter-clockwise">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Rotate left" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="RotateRightButton" Appearance="Secondary" Padding="12,7" Margin="0,0,8,0"
                           Click="RotateRightButton_Click" ToolTip="Rotate 90 degrees clockwise">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="-1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="Rotate right" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="CropModeButton" Appearance="Secondary" Padding="12,7" Margin="0,0,8,0"
                           Click="CropModeButton_Click" ToolTip="Drag on the page to select the area to keep">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Crop" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="ResetButton" Appearance="Secondary" Padding="12,7"
                           Click="ResetButton_Click" Content="Reset" ToolTip="Undo all edits in this preview"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="PrevButton" Appearance="Transparent" Padding="8,6"
                           Click="PrevButton_Click" ToolTip="Previous page">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </ui:Button>
                <TextBlock x:Name="PageIndicatorText" Text="Page 1 of 1" FontSize="12" Margin="6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:Button x:Name="NextButton" Appearance="Transparent" Padding="8,6"
                           Click="NextButton_Click" ToolTip="Next page">
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Stage -->
        <Border Grid.Row="2" Margin="20,0,20,0" CornerRadius="8" ClipToBounds="True"
                Background="#FF1C1C1C"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid x:Name="StageHost" SizeChanged="StageHost_SizeChanged"
                  MouseLeftButtonDown="Stage_MouseLeftButtonDown"
                  MouseMove="Stage_MouseMove"
                  MouseLeftButtonUp="Stage_MouseLeftButtonUp"
                  MouseLeave="Stage_MouseLeave">

                <Image x:Name="PreviewImage" Stretch="Fill"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <Canvas x:Name="CropLayer" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <Path x:Name="CropDimPath" Fill="#99000000"/>
                    <Rectangle x:Name="CropSelectionRect" Stroke="#FFFFFFFF" StrokeThickness="1.5"
                               StrokeDashArray="4 3" Visibility="Collapsed"/>
                    <Rectangle x:Name="CropHandle" Width="10" Height="10" Fill="#FFFFFFFF"
                               Visibility="Collapsed"/>
                </Canvas>

                <TextBlock x:Name="EmptyHint" Style="{StaticResource StageHint}"
                           Text="Click Crop, then drag on the page to choose the area to keep."
                           VerticalAlignment="Bottom" Margin="0,0,0,14" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="20,12,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="EditSummaryText" VerticalAlignment="Center" FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button x:Name="CancelButton" Appearance="Secondary" Content="Cancel"
                           Padding="18,8" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <ui:Button x:Name="ApplyButton" Appearance="Primary" Content="Apply"
                           Padding="22,8" Click="ApplyButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
