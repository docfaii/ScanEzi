<ui:FluentWindow x:Class="ScanEzi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ScanEzi"
        Width="1120" Height="760"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Icon="pack://application:,,,/Assets/ScanEzi.ico">

    <ui:FluentWindow.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Grid.Row="0" Title="ScanEzi" />

        <!-- Command bar: active device + settings + primary action -->
        <Grid Grid.Row="1" Margin="24,4,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Active device -->
                <ui:Card Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE729;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ActiveDeviceText" Text="Searching for scanners..."
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                    </StackPanel>
                </ui:Card>

                <ui:Button x:Name="SettingsToggleButton" Appearance="Secondary" ToolTip="Device and scan settings"
                           Click="SettingsToggleButton_Click" Padding="9,6" Margin="0,0,16,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </ui:Button>

                <!-- Active settings summary -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource BadgeBorder}">
                        <TextBlock x:Name="PaperSizeBadge" Style="{StaticResource BadgeText}" Text="Size: A4"/>
                    </Border>
                    <Border Style="{StaticResource BadgeBorder}">
                        <TextBlock x:Name="DuplexBadge" Style="{StaticResource BadgeText}" Text="Sides: 1-Sided"/>
                    </Border>
                    <Border Style="{StaticResource BadgeBorder}">
                        <TextBlock x:Name="SourceBadge" Style="{StaticResource BadgeText}" Text="Source: Auto Detect"/>
                    </Border>
                    <Border Style="{StaticResource BadgeBorder}">
                        <TextBlock x:Name="FormatBadge" Style="{StaticResource BadgeText}" Text="Save: PDF"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <ui:Button Grid.Column="1" x:Name="QuickScanButton" Appearance="Primary"
                       Content="Scan Now" Height="36" Padding="20,0" Click="ScanButton_Click"/>
        </Grid>

        <!-- Inline status banner + collapsible settings panel -->
        <StackPanel Grid.Row="2" Margin="24,0,24,12">
            <Border x:Name="StatusBanner" Visibility="Collapsed" CornerRadius="8"
                    Padding="14,10" Margin="0,0,0,8" BorderThickness="1"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCriticalBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="BannerIcon" Grid.Column="0" Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               VerticalAlignment="Top" Margin="0,2,10,0"/>

                    <TextBlock x:Name="BannerText" Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>

                    <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6,4" Margin="8,0,0,0"
                               ToolTip="Dismiss" Click="BannerCloseButton_Click">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </ui:Button>
                </Grid>
            </Border>

            <ui:Card x:Name="SettingsPanel" Padding="20,16" Visibility="Collapsed">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="258" Margin="0,0,16,0">
                        <TextBlock Text="Scanner" Style="{StaticResource SettingLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ScannerComboBox" Grid.Column="0" Height="34"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="ScannerComboBox_SelectionChanged">
                                <ComboBoxItem Content="Searching for scanners..." IsSelected="True"/>
                            </ComboBox>

                            <ui:Button x:Name="RefreshScannerButton" Grid.Column="1" Appearance="Secondary"
                                       Height="34" Padding="10,0" Margin="6,0,0,0"
                                       ToolTip="Refresh scanner list"
                                       Click="RefreshScannerButton_Click">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                            </ui:Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Width="120" Margin="0,0,16,0">
                        <TextBlock Text="Page Size" Style="{StaticResource SettingLabel}"/>
                        <ComboBox x:Name="PaperSizeComboBox" Height="34" VerticalContentAlignment="Center"
                                  SelectionChanged="PaperSizeComboBox_SelectionChanged">
                            <ComboBoxItem Content="A4" IsSelected="True"/>
                            <ComboBoxItem Content="Letter"/>
                            <ComboBoxItem Content="Legal"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Width="150" Margin="0,0,16,0">
                        <TextBlock Text="Sides" Style="{StaticResource SettingLabel}"/>
                        <ComboBox x:Name="DuplexComboBox" Height="34" VerticalContentAlignment="Center"
                                  SelectionChanged="DuplexComboBox_SelectionChanged">
                            <ComboBoxItem Content="1-Sided (Simplex)" IsSelected="True"/>
                            <ComboBoxItem Content="2-Sided (Duplex)"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Width="150" Margin="0,0,16,0">
                        <TextBlock Text="Source" Style="{StaticResource SettingLabel}"/>
                        <ComboBox x:Name="SourceComboBox" Height="34" VerticalContentAlignment="Center"
                                  SelectionChanged="SourceComboBox_SelectionChanged">
                            <ComboBoxItem Content="Auto Detect" IsSelected="True"/>
                            <ComboBoxItem Content="Document Feeder"/>
                            <ComboBoxItem Content="Flatbed"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Width="170">
                        <TextBlock Text="Save as" Style="{StaticResource SettingLabel}"/>
                        <ComboBox x:Name="FormatComboBox" Height="34" VerticalContentAlignment="Center"
                                  SelectionChanged="FormatComboBox_SelectionChanged">
                            <ComboBoxItem Content="PDF document" IsSelected="True"/>
                            <ComboBoxItem Content="JPG images"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Width="190" Margin="16,0,0,0">
                        <TextBlock Text="Empty pages" Style="{StaticResource SettingLabel}"/>
                        <ui:ToggleSwitch x:Name="DiscardBlankToggle" IsChecked="True"
                                         OnContent="Discard" OffContent="Keep"
                                         MinWidth="0" Margin="0,6,0,0"
                                         HorizontalAlignment="Left"
                                         Checked="DiscardBlankToggle_Changed"
                                         Unchecked="DiscardBlankToggle_Changed"/>
                    </StackPanel>

                    <StackPanel Width="190" Margin="16,0,0,0">
                        <TextBlock Text="Auto orientation" Style="{StaticResource SettingLabel}"/>
                        <ui:ToggleSwitch x:Name="AutoOrientToggle" IsChecked="True"
                                         OnContent="On" OffContent="Off"
                                         MinWidth="0" Margin="0,6,0,0"
                                         HorizontalAlignment="Left"
                                         Checked="AutoOrientToggle_Changed"
                                         Unchecked="AutoOrientToggle_Changed"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Saved automatically" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Changes apply to your next scan and are remembered."
                               TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="CapabilityText" Text=""
                               TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>
        </StackPanel>

        <!-- Thumbnail workspace -->
        <ui:Card Grid.Row="3" Margin="24,0,24,12" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="ThumbnailPanel" Margin="16">
                    <Border x:Name="EmptyPlaceholder" Width="320" Height="220" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" HorizontalAlignment="Center" Margin="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock Text="No scans yet" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Press Scan Now to capture a page" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="Click a page to preview, crop or rotate it" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </ScrollViewer>
        </ui:Card>

        <!-- Footer -->
        <Border Grid.Row="4" Padding="24,0,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="SaveButton" Content="Save as PDF..." Appearance="Primary"
                               Click="SaveButton_Click" Padding="18,7" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
